# Borsa Bot environment (never commit real secrets)
# APP_ENV: DEVELOPMENT | TEST | PRODUCTION
# PRODUCTION hard-blocks simulated/mock market data (fail closed → NO MARKET DATA)
APP_ENV=DEVELOPMENT
MODE=PAPER
STARTING_CASH=100000
MAX_PORTFOLIO_RISK_PCT=1.0
MAX_POSITION_RISK_PCT=0.75
MAX_OPEN_POSITIONS=5
MAX_SECTOR_POSITIONS=2
DAILY_MAX_LOSS_PCT=2.0
WEEKLY_MAX_LOSS_PCT=5.0
MAX_DRAWDOWN_PCT=12.0
DEFENSIVE_DD_PCT=4.0
HIGH_RISK_DD_PCT=7.0
CAPITAL_PROTECTION_DD_PCT=10.0
ATR_STOP_MULT=2.0
ATR_TAKE_MULT=3.0
ATR_TRAIL_MULT=2.0
BREAKEVEN_R_MULTIPLE=1.0
MIN_RISK_REWARD=1.5
PREFERRED_RISK_REWARD=2.0
MIN_EXPECTED_VALUE=0.0
BUY_SCORE_THRESHOLD=60
STRONG_BUY_THRESHOLD=65
WATCH_THRESHOLD=55
SELL_SCORE_THRESHOLD=75
CONSECUTIVE_LOSS_REDUCE=3
CONSECUTIVE_LOSS_PAUSE=5
TP1_EXIT_PCT=0.25
TP2_EXIT_PCT=0.25
TP3_EXIT_PCT=0.25
TRAIL_EXIT_PCT=0.25
ALLOW_DCA=false
COMMISSION_PCT=0.002
SLIPPAGE_PCT=0.0005
MAX_SPREAD_PCT=0.8
# DEVELOPMENT/TEST may use simulated. PRODUCTION must NEVER use simulated/mock.
# auto = Yahoo BIST when session OPEN (10–18 Istanbul), simulated when CLOSED
DATA_PROVIDER=auto
# For real feed: DATA_PROVIDER=live + MARKET_DATA_URL + MARKET_DATA_TOKEN
# Or Yahoo only: DATA_PROVIDER=yahoo
# Or fail-closed empty UI: DATA_PROVIDER=required
# PRODUCTION + simulated → PRODUCTION_MARKET_DATA_VIOLATION (RequiredLiveProvider / NO DATA)
DATA_FRESHNESS_SEC=30
SIGNAL_TTL_SEC=3600
DAILY_TOP_N=8
ALLOW_SIMULATED_PAPER=true
KILL_SWITCH=false
REQUIRE_MANUAL_APPROVAL=true
API_HOST=0.0.0.0
API_PORT=8090
LONG_TERM_CAPITAL_PCT=0.50
SWING_CAPITAL_PCT=0.25
DAY_TRADING_CAPITAL_PCT=0.10
CASH_RESERVE_PCT=0.15
DAY_MAX_DAILY_LOSS_PCT=1.0
DAY_MAX_TRADES_PER_DAY=8
DAY_MAX_CONSECUTIVE_LOSSES=3
DAY_MAX_POSITION_PCT=5.0
DAY_MAX_EXPOSURE_PCT=15.0

# --- Alerts (never affect trading decisions; SIGNAL ≠ EXECUTION) ---
SMS_ON=false
PUSH_ON=true
SOUND_ON=true
TTS_ON=true
ALERT_COOLDOWN_SECONDS=300
PUSH_ENABLED=false
SMS_PROVIDER=null
FAVORITE_VOICE_ALERT=true
FAVORITE_SCAN_BOOST=true


# --- CRYPTO foundation — default OFF; does not affect BIST ---
# Live MD: public CEX REST (same venues CCXT/GitHub bots use: OKX → Gate → Kraken).
# Paribu is optional. No API keys for public ticker/OHLCV. No invented prices.
CRYPTO_ENABLED=false
CRYPTO_PROVIDER=auto
# auto|public|ccxt|failover → multi-venue; or single: okx|gate|kraken|paribu
CRYPTO_FAILOVER=okx,gate,kraken
PARIBU_ENABLED=false
# Optional TR venue (docs.paribu.com). Appended to failover when true.
# Enable CRYPTO_ENABLED=true (+ optional PARIBU_ENABLED). PAPER orders only.
# Paribu has no official candle API — OHLCV from /trades + WS; public CEX has native candles.
PARIBU_API_BASE=https://api.paribu.com
PARIBU_API_KEY=
PARIBU_API_SECRET=
PARIBU_WS_ENABLED=true
PARIBU_POLL_INTERVAL_SEC=3
CRYPTO_SIGNALS_ENABLED=false
# Signals also require reliable LIVE/DELAYED MD (crypto.reliability.crypto_signals_permitted).
# Stale/unavailable/simulated crypto feeds fail-closed → empty scan (PAPER only; LIVE broker locked).
CRYPTO_PREDICTIONS_ENABLED=true
CRYPTO_PAPER_TRADING_ENABLED=false
CRYPTO_SCAN_MAX_SYMBOLS=40
CRYPTO_MAX_EXPOSURE_PCT=15
CRYPTO_ATR_CAP_PCT=8

# --- Phase 6–7 autonomy ---
AUTONOMOUS_MODE=true
AUTONOMY_ENABLED=true
USER_TRADING_MODE=PAPER
EXECUTION_MODE=PAPER
LIVE_BROKER_ENABLED=false
LIVE_CONFIRMATION_REQUIRED=true
LIVE_CONFIRMED=false
# Live money foundation (infra only — leave locked until a real venue adapter exists)
LIVE_BROKER_ADAPTER=disabled
LIVE_DRY_RUN=true
# LIVE_BROKER_BASE_URL=
# LIVE_BROKER_API_KEY=
# LIVE_BROKER_API_SECRET=
# LIVE_BROKER_ACCOUNT_ID=
AUTONOMY_DEEP_MAX=40
AUTONOMY_SCAN_COOLDOWN_SECONDS=25
AUTONOMY_IDEMPOTENCY_MINUTES=15

# Phase 2 — real MD + paper FSM + auth
# DATA_PROVIDER=live requires MARKET_DATA_URL + MARKET_DATA_TOKEN (REST /v1/symbols|quote|bars)
# MARKET_DATA_URL=
# MARKET_DATA_TOKEN=
PAPER_PARTIAL_FILL_PCT=1.0
PAPER_CANCEL_RACE_FILL_PCT=0.0
BLOCK_ORDERS_WHEN_MARKET_CLOSED=true
ALLOW_PAPER_WHEN_CLOSED=true
BIST_PAPER_AUTO_FOLLOW=true
PAPER_WALLET_CYCLE_SEC=90
AUTH_ENABLED=false
# AUTH_ADMIN_TOKEN=
# AUTH_TRADER_TOKEN=
# AUTH_VIEWER_TOKEN=
AUTH_SESSION_TTL_SEC=86400

