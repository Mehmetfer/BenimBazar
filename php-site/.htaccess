# BenimBazar — PHP + MySQL + Mobil REST API (/api/v1/)
DirectoryIndex index.php

<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Eski Flutter / Python dosya kalıntıları
  RewriteRule ^(main\.dart\.js|flutter\.js|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ - [R=410,L]
  RewriteRule ^php/proxy\.php$ - [R=410,L]

  # Mobil REST API — /api/v1/* doğrudan PHP dosyalarına gider
  RewriteRule ^api/v1/auth/login/?$         api/v1/auth/login.php [L,QSA]
  RewriteRule ^api/v1/auth/register/?$      api/v1/auth/register.php [L,QSA]
  RewriteRule ^api/v1/auth/logout/?$        api/v1/auth/logout.php [L,QSA]
  RewriteRule ^api/v1/auth/me/?$            api/v1/auth/me.php [L,QSA]
  RewriteRule ^api/v1/listings/?$           api/v1/listings/index.php [L,QSA]
  RewriteRule ^api/v1/listings/detail/?$    api/v1/listings/detail.php [L,QSA]
  RewriteRule ^api/v1/listings/favorites/?$ api/v1/listings/favorites.php [L,QSA]
  RewriteRule ^api/v1/listings/my/?$        api/v1/listings/my.php [L,QSA]
  RewriteRule ^api/v1/messages/?$           api/v1/messages/index.php [L,QSA]
  RewriteRule ^api/v1/user/notifications/?$ api/v1/user/notifications.php [L,QSA]
  RewriteRule ^api/v1/user/profile/?$       api/v1/user/profile.php [L,QSA]
  # Bilinmeyen /api/v1/* — 404
  RewriteRule ^api/v1/ - [R=404,L]

  # Eski index.html yer imi
  RewriteRule ^index\.html$ /index.php [R=301,L]

  RewriteRule ^galeriler/?$ galeriler.php [L,QSA]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.php$ - [L]
  RewriteRule ^sitemap-listings\.php$ - [L]
  RewriteRule ^kktc/?$ index.php?__seo_path=kktc [L,QSA]
  RewriteRule ^kktc/(.+)$ index.php?__seo_path=kktc/$1 [L,QSA]
  RewriteRule ^arac/(.+)$ index.php?__seo_path=arac/$1 [L,QSA]

  RewriteRule \.php$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>
