# BenimBazar — PHP + MySQL (Flutter / REST API yok)
DirectoryIndex index.php

<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Eski Flutter / Python API kalintilari — kaldirildi
  RewriteRule ^(main\.dart\.js|flutter\.js|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ - [R=410,L]
  RewriteRule ^api(/|$) - [R=410,L]
  RewriteRule ^php/proxy\.php$ - [R=410,L]

  # Eski index.html yer imi
  RewriteRule ^index\.html$ /index.php [R=301,L]

  RewriteRule \.php$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>
